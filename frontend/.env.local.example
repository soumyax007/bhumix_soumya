# Bhumix Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Live APIs on Render (already deployed — do not change these URLs
# unless the services are redeployed elsewhere)
VITE_SCAN_URL=https://bhumix-scan.onrender.com
VITE_TRANSLATE_URL=https://bhumix-traslation.onrender.com
